#
# Compilers

F90=mpiifx
F77=mpiifx
CC=mpiicx

# Linkers 
FL=$(F90)
CL=$(CC)

# 
RM = /bin/rm -f 

# Library archiver
AR = ar vr 
RANLIB = ranlib

TAGS =etags

#Prefx for preprocessor directives. 
FDP=-D
#FDP=-WF,-D

CDP=-D
#CDP=-Wp,-D

#LAPACK= -lmkl_intel_lp64 -lmkl_sequential -lmkl_core  -lpthread -lm
#LAPACK= -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5  -lpthread -lm
#LAPACK = -lblas -llapack
#SCALAPACK= -lmkl_scalapack_lp64  -lmkl_blacs_intelmpi_lp64
#SCALAPACK= -L/usr/lib/x86_64-linux-gnu/ -lscalapack-openmpi

LD_LOCAL=/home/maz/local2

INCHDF5=-I$(LD_LOCAL)/hdf5/include/
HDF5LIB= -L$(LD_LOCAL)/hdf5/lib -lhdf5_hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5

MPI_INC= #-I/usr/include/openmpi-x86_64/  -I/usr/lib64/gfortran/modules/openmpi/
MPI_LIB= #-lmpif -lmpi

XTRA_LIB = 
#Sparse solver to usge

#Use available dbl-complex MUMPS library
SP_SOLVER=USE_ZMUMPS 
SOLVER_INC=-I$(LD_LOCAL)/include/ -I$(LD_LOCAL)/metis/include/
SOLVER_LIB=-L$(LD_LOCAL)/lib/ -L$(LD_LOCAL)/metis/lib/ -lzmumps -lmumps_common -lparmetis -lmetis -lGKlib -lpord
#        -lptesmumps # -lptscotch -lptscotcherr -lscotch -lscotcherr

#SOLVER_LIB=-lzmumps -lmumps_common -lpord 
        
#Use SGI's SCSL library
#SP_SOLVER=USE_SCSL

#Use SPOOLES library, should be provided separately
#SP_SOLVER=USE_SPOOLES 
#SOLVER_INC=-I/home/tcmsstar/work/codes/libsrc/spooles 

#Use Pardiso library
#SP_SOLVER=USE_PARDISO

#Use IBM's WSMP library
#SP_SOLVER=USE_WSMP


#Preprocessor defs for C
CDEFS   = $(CDP)$(SP_SOLVER) 

#Preprocessor defs for Fortran    
FDEFS= $(FDP)HAVE_QUADPREC \
       $(FDP)$(SP_SOLVER) \
       $(FDP)SP_CONV_INPLACE $(FDP)intel_ $(FDP)_LINUX $(FDP)ALLOW_NON_INIT
#       $(FDP)NTS_LPK       
#       $(FDP)DO_SC_SYM
#       $(FDP)HAVE_NAN \


#Begin Optimization options
#OPTS=  -O3 -fopenmp # -pg #-parallel 

#OPTS=  -O2  -align -g
#USING GFORTRAN USE THIS
OPTS = -O2 -align -qopenmp  #-std=gnu

INCS=$(MPI_INC) $(SOLVER_INC) $(INCHDF5)

CFLAGS= $(OPTS) $(CDEFS)  $(INCS) -lm 
F90FLAGS= -fpp $(OPTS)   $(FDEFS) $(INCS) 
F77FLAGS=$(F90FLAGS) $(INCS)

LOPTS= $(OPTS) 
LAPACK=-qmkl=cluster
LFLAGS= $(LOPTS) $(HDF5LIB) $(SOLVER_LIB) $(SCALAPACK) $(LAPACK) $(MPI_LIB) $(XTRA_LIB)

#End Optimization options

